// Starter spec, read from the code and traces by portal (no AI).
// It says what exists. Add what the code can't: domains, your names,
// rules, and what you plan to build.
// Conventions: https://portal.haris-d21.workers.dev/skills/portal-architecture/SKILL.md
model {
  system = domain 'opentelemetry-demo' {
    ad = service 'ad' {  // compose.yaml:32
      technology 'Java · gRPC'
      metadata {
        code 'src/ad/**'
        otel_service 'ad'
        resource 'ad'
      }
    }
    cart = service 'cart' {  // compose.yaml:80
      technology 'C# · gRPC · REST'
      metadata {
        code 'src/cart/src/**'
        otel_service 'cart'
        resource 'cart'
      }
    }
    checkout = service 'checkout' {  // compose.yaml:118
      technology 'Go · gRPC'
      metadata {
        code 'src/checkout/**'
        otel_service 'checkout'
        resource 'checkout'
      }
    }
    currency = service 'currency' {  // compose.yaml:180
      technology 'C++ · gRPC'
      metadata {
        code 'src/currency/**'
        otel_service 'currency'
        resource 'currency'
      }
    }
    email = service 'email' {  // compose.yaml:218
      technology 'Ruby · Sinatra · REST'
      metadata {
        code 'src/email/**'
        otel_service 'email'
        resource 'email'
      }
    }
    frontend = service 'frontend' {  // compose.yaml:255
      technology 'TypeScript · Next.js'
      metadata {
        code 'src/frontend/**'
        otel_service 'frontend'
        resource 'frontend'
      }
    }
    frontend_proxy = service 'frontend-proxy' {  // compose.yaml:323
      technology 'ghcr.io/open-telemetry/demo:latest-frontend-proxy'
      metadata {
        otel_service 'frontend-proxy'
        resource 'frontend-proxy'
      }
    }
    image_provider = service 'image-provider' {  // compose.yaml:389
      technology 'ghcr.io/open-telemetry/demo:latest-image-provider'
      metadata {
        otel_service 'image-provider'
        resource 'image-provider'
      }
    }
    load_generator = service 'load-generator' {  // compose.yaml:422
      technology 'Python · Flask · WebSocket'
      metadata {
        code 'src/load-generator/**'
        otel_service 'load-generator'
        resource 'load-generator'
      }
    }
    payment = service 'payment' {  // compose.yaml:471
      technology 'JavaScript · gRPC'
      metadata {
        code 'src/payment/**'
        otel_service 'payment'
        resource 'payment'
      }
    }
    product_catalog = service 'product-catalog' {  // compose.yaml:521
      technology 'Go · gRPC'
      metadata {
        code 'src/product-catalog/**'
        otel_service 'product-catalog'
        resource 'product-catalog'
      }
    }
    quote = service 'quote' {  // compose.yaml:571
      technology 'PHP · Slim'
      metadata {
        code 'src/quote/**'
        otel_service 'quote'
        resource 'quote'
      }
    }
    recommendation = service 'recommendation' {  // compose.yaml:608
      technology 'Java · Spring Boot'
      metadata {
        code 'src/recommendation/**'
        otel_service 'recommendation'
        resource 'recommendation'
      }
    }
    shipping = service 'shipping' {  // compose.yaml:654
      technology 'Rust · Actix Web · REST'
      metadata {
        code 'src/shipping/**'
        otel_service 'shipping'
        resource 'shipping'
      }
    }
    flagd = service 'flagd' {  // compose.yaml:702
      technology 'ghcr.io/open-feature/flagd:v0.19.0'
      metadata {
        otel_service 'flagd'
        resource 'flagd'
      }
    }
    flagd_ui = service 'flagd-ui' {  // compose.yaml:729
      technology 'Elixir · Phoenix · REST'
      metadata {
        code 'src/flagd-ui/**'
        otel_service 'flagd-ui'
        resource 'flagd-ui'
      }
    }
    telemetry_docs = service 'telemetry-docs' {  // compose.yaml:768
      technology 'Python'
      metadata {
        code 'src/telemetry-docs/**'
        otel_service 'telemetry-docs'
        resource 'telemetry-docs'
      }
    }
    astronomy_db = datastore 'astronomy-db' {  // compose.yaml:797
      technology 'postgres:19.0'
      metadata {
        resource 'astronomy-db'
      }
    }
    valkey_cart = datastore 'valkey-cart' {  // compose.yaml:821
      technology 'ghcr.io/valkey-io/valkey:9.2.0-alpine3.24'
      metadata {
        resource 'valkey-cart'
      }
    }
    otel_collector = infra 'otel-collector' {  // compose.yaml:847
      technology 'ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib:0.165.0'
      metadata {
        resource 'otel-collector'
      }
    }
    agent = service 'agent' {  // compose.agent.yaml:16
      technology 'Python · FastAPI · WebSocket'
      metadata {
        code 'src/agent/**'
        otel_service 'agent'
        resource 'agent'
      }
    }
    mcp = service 'mcp' {  // compose.agent.yaml:69
      technology 'Python · FastAPI · WebSocket'
      metadata {
        code 'src/mcp/**'
        otel_service 'mcp'
        resource 'mcp'
      }
    }
    chatbot = service 'chatbot' {  // compose.agent.yaml:101
      technology 'Python · FastAPI'
      metadata {
        code 'src/chatbot/**'
        otel_service 'chatbot'
        resource 'chatbot'
      }
    }
    accounting = service 'accounting' {  // compose.full.yaml:12
      technology 'C#'
      metadata {
        code 'src/accounting/**'
        otel_service 'accounting'
        resource 'accounting'
      }
    }
    fraud_detection = service 'fraud-detection' {  // compose.full.yaml:47
      technology 'Kotlin'
      metadata {
        code 'src/fraud-detection/**'
        otel_service 'fraud-detection'
        resource 'fraud-detection'
      }
    }
    kafka = event 'kafka' {  // compose.full.yaml:89
      technology 'ghcr.io/open-telemetry/demo:latest-kafka'
      metadata {
        resource 'kafka'
      }
    }
    jaeger = infra 'jaeger' {  // compose.observability.yaml:13
      technology 'quay.io/jaegertracing/jaeger:2.23.0'
      metadata {
        resource 'jaeger'
      }
    }
    grafana = infra 'grafana' {  // compose.observability.yaml:43
      technology 'grafana/grafana:13.3.1'
      metadata {
        resource 'grafana'
      }
    }
    prometheus = infra 'prometheus' {  // compose.observability.yaml:65
      technology 'quay.io/prometheus/prometheus:v3.16.0'
      metadata {
        resource 'prometheus'
      }
    }
    opensearch = service 'opensearch' {  // compose.observability.yaml:94
      technology 'ghcr.io/open-telemetry/demo:latest-opensearch'
      metadata {
        otel_service 'opensearch'
        resource 'opensearch'
      }
    }
    opamp_server = service 'opamp-server' {  // compose.observability.yaml:141
      technology 'ghcr.io/open-telemetry/demo:latest-opamp-server'
      metadata {
        otel_service 'opamp-server'
        resource 'opamp-server'
      }
    }
    otel_ebpf_profiler = infra 'otel-ebpf-profiler' {  // compose.profiling.yaml:10
      technology 'ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-ebpf-profiler:0.165.0'
      metadata {
        resource 'otel-ebpf-profiler'
      }
    }
    firepit = service 'firepit' {  // compose.profiling.yaml:31
      technology 'ghcr.io/florianl/firepit:v0.3.0'
      metadata {
        otel_service 'firepit'
        resource 'firepit'
      }
    }
  }

  ad -[request]-> flagd  // env.FLAGD_HOST
  cart -[request]-> flagd  // env.FLAGD_HOST
  cart -> valkey_cart  // reads or writes? say which: -[reads]-> or -[writes]->
  checkout -[request]-> flagd  // env.FLAGD_HOST
  checkout -[request]-> cart  // env.CART_ADDR
  checkout -[request]-> currency  // env.CURRENCY_ADDR
  checkout -[request]-> email  // env.EMAIL_ADDR
  checkout -[request]-> payment  // env.PAYMENT_ADDR
  checkout -[request]-> product_catalog  // env.PRODUCT_CATALOG_ADDR
  checkout -[request]-> shipping  // env.SHIPPING_ADDR
  email -[request]-> flagd  // env.FLAGD_HOST
  frontend -[request]-> ad  // env.AD_ADDR
  frontend -[request]-> cart  // env.CART_ADDR
  frontend -[request]-> checkout  // env.CHECKOUT_ADDR
  frontend -[request]-> currency  // env.CURRENCY_ADDR
  frontend -[request]-> product_catalog  // env.PRODUCT_CATALOG_ADDR
  frontend -[request]-> recommendation  // env.RECOMMENDATION_ADDR
  frontend -[request]-> shipping  // env.SHIPPING_ADDR
  frontend -[request]-> flagd  // env.FLAGD_HOST
  frontend_proxy -[request]-> frontend  // env.FRONTEND_HOST
  frontend_proxy -[request]-> load_generator  // env.LOCUST_WEB_HOST
  frontend_proxy -[request]-> image_provider  // env.IMAGE_PROVIDER_HOST
  frontend_proxy -[request]-> flagd  // env.FLAGD_HOST
  frontend_proxy -[request]-> flagd_ui  // env.FLAGD_UI_HOST
  frontend_proxy -[request]-> telemetry_docs  // env.TELEMETRY_DOCS_HOST
  load_generator -[request]-> frontend_proxy  // env.LOCUST_HOST
  load_generator -[request]-> flagd  // env.FLAGD_HOST
  payment -[request]-> flagd  // env.FLAGD_HOST
  product_catalog -[request]-> flagd  // env.FLAGD_HOST
  product_catalog -> astronomy_db  // reads or writes? say which: -[reads]-> or -[writes]->
  recommendation -[request]-> product_catalog  // env.PRODUCT_CATALOG_ADDR
  recommendation -[request]-> flagd  // env.FLAGD_HOST
  shipping -[request]-> quote  // env.QUOTE_ADDR
  shipping -[request]-> flagd  // env.FLAGD_HOST
  agent -[request]-> mcp  // env.MCP_ENDPOINT
  chatbot -[request]-> agent  // env.AGENT_ENDPOINT
  load_generator -[request]-> agent  // env.AGENT_ENDPOINT
  accounting -[request]-> kafka  // env.KAFKA_ADDR
  fraud_detection -[request]-> kafka  // env.KAFKA_ADDR
  checkout -[request]-> kafka  // env.KAFKA_ADDR
  cart -[request]-> opamp_server  // env.OPAMP_SERVER_ENDPOINT
  product_catalog -[request]-> opamp_server  // env.OPAMP_SERVER_ENDPOINT
  accounting -> astronomy_db  // reads or writes? say which: -[reads]-> or -[writes]->
  agent -[request]-> flagd  // env.FLAGD_HOST
  chatbot -[request]-> opamp_server  // env.OPAMP_SERVER_ENDPOINT
}

specification {
  element domain
  element service
  element event
  element datastore
  element infra
  element component
  relationship request
  relationship publishes
  relationship consumes
  relationship reads
  relationship writes
}
